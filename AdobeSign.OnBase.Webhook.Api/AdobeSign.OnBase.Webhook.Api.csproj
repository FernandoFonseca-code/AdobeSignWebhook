<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Publish the .NET Framework OnBase updater into an "updater" subfolder of the webhook's publish folder. -->
  <Target Name="PublishOnBaseUpdater" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\AdobeSign.OnBase.Updater\AdobeSign.OnBase.Updater.csproj&quot; -c $(Configuration) -o &quot;$(PublishDir)updater&quot;" />
  </Target>

</Project>
